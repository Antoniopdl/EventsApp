# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO (Mobiliario App)
# Copia este archivo a .env.local y completa con tus credenciales reales
# ==============================================================================

# Supabase (Configuración de Base de Datos y Autenticación)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-privada

# Google Maps API (Geocodificación, Distancias y Rutas de Flete)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=tu-google-maps-api-key
